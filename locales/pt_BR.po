#. London fork: manual timer creation.
msgid "Add a manual timer"
msgstr "Adicionar apontamento manual"

msgid "Enter the start and end of the period worked."
msgstr "Informe o início e o término do período trabalhado."

msgid "Existing timers"
msgstr "Apontamentos existentes"

msgid "Actual time follows the recorded technician; task duration follows the current assignee."
msgstr "O tempo real segue o técnico do apontamento; a duração da tarefa segue o responsável atual."

msgid "You do not have permission to control this timer."
msgstr "Você não tem permissão para controlar este cronômetro."

#, php-format
msgid "Running tasks (%d)"
msgstr "Tarefas em execução (%d)"

#, php-format
msgid "Task #%d"
msgstr "Tarefa #%d"

msgid "Start timer"
msgstr "Iniciar cronômetro"

msgid "Pause timer"
msgstr "Pausar cronômetro"

msgid "Resume timer"
msgstr "Retomar cronômetro"

msgid "Stop timer"
msgstr "Encerrar cronômetro"

msgid "Delete timer"
msgstr "Excluir apontamento"

msgid "Permanently delete this timer? Its dates and duration will remain in the item history."
msgstr "Excluir definitivamente este apontamento? Os horários e a duração permanecerão no histórico do item."

msgid "Confirm deletion"
msgstr "Confirmar exclusão"

msgid "Pause the running timer before deleting this entry."
msgstr "Pause o cronômetro ativo antes de excluir este apontamento."

msgid "Confirm the timer deletion before continuing."
msgstr "Confirme a exclusão do apontamento antes de continuar."

msgid "Timer deleted."
msgstr "Apontamento excluído."

msgid "Could not delete the timer."
msgstr "Não foi possível excluir o apontamento."

msgid "Could not delete the timer. No changes were saved."
msgstr "Não foi possível excluir o apontamento. Nenhuma alteração foi salva."

#, php-format
msgid "Deleted timer #%1$d, task #%2$d, technician #%3$d: %4$s - %5$s (%6$d seconds)."
msgstr "Apontamento excluído #%1$d, tarefa #%2$d, técnico #%3$d: %4$s - %5$s (%6$d segundos)."

msgid "Edit start and end dates. For a running timer, only the start can be changed."
msgstr "Edite o início e o término. Em um cronômetro ativo, somente o início pode ser alterado."

#, php-format
msgid "Timer #%d"
msgstr "Apontamento #%d"

msgid "Invalid timer task."
msgstr "Tarefa do apontamento inválida."

msgid "Could not save the timer changes."
msgstr "Não foi possível salvar as alterações dos apontamentos."

msgid "Close and reopen the timer editor before saving."
msgstr "Feche e abra novamente o editor de apontamentos antes de salvar."

msgid "One of the timers is unavailable. Reopen the editor."
msgstr "Um dos apontamentos não está disponível. Abra novamente o editor."

msgid "A timer changed while the editor was open. Review its latest values."
msgstr "Um apontamento foi alterado enquanto o editor estava aberto. Confira os valores mais recentes."

msgid "This timer changed. Its latest values are shown."
msgstr "Este apontamento foi alterado. Os valores mais recentes estão sendo exibidos."

msgid "Pause or stop the running timer before changing its end."
msgstr "Pause ou encerre o cronômetro ativo antes de alterar o término."

msgid "A running timer cannot start in the future."
msgstr "Um cronômetro ativo não pode iniciar no futuro."

msgid "Timer changes saved."
msgstr "Alterações dos apontamentos salvas."

msgid "No timer changes to save."
msgstr "Nenhuma alteração nos apontamentos para salvar."

msgid "Could not save the timer changes. No changes were saved."
msgstr "Não foi possível salvar as alterações dos apontamentos. Nenhuma alteração foi salva."

msgid "Could not update the timer. Refresh the task and try again."
msgstr "Não foi possível atualizar o cronômetro. Atualize a tarefa e tente novamente."

#, php-format
msgid "Timer #%1$d, task #%2$d: %3$s / %4$s -> %5$s / %6$s."
msgstr "Apontamento #%1$d, tarefa #%2$d: %3$s / %4$s -> %5$s / %6$s."

msgid "Enter valid start and end dates."
msgstr "Informe datas e horários válidos de início e término."

msgid "The end must be later than the start."
msgstr "O término deve ser posterior ao início."

msgid "A completed timer cannot end in the future."
msgstr "Um apontamento encerrado não pode terminar no futuro."

msgid "The interval overlaps an existing timer for this task."
msgstr "O intervalo coincide com um apontamento existente nesta tarefa."

msgid "You do not have permission to modify these timers."
msgstr "Você não tem permissão para modificar estes apontamentos."

msgid "Could not save the manual timer."
msgstr "Não foi possível salvar o apontamento manual."

msgid "Could not update the task duration."
msgstr "Não foi possível atualizar a duração da tarefa."

msgid "Could not save the manual timer. No changes were saved."
msgstr "Não foi possível salvar o apontamento manual. Nenhuma alteração foi salva."

msgid "Manual timer added."
msgstr "Apontamento manual adicionado."

#, php-format
msgid "Manual timer #%1$d, task #%2$d, technician #%3$d: %4$s - %5$s (%6$d seconds)."
msgstr "Apontamento manual #%1$d, tarefa #%2$d, técnico #%3$d: %4$s - %5$s (%6$d segundos)."

